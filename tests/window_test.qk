// window v1.4.0, headless (SDL's dummy video driver — no display needed).
// Needs SDL2 installed; every test is skipped (passes) when it isn't.
use window
use fs
use test

bg := window.rgb(10, 20, 30)

define open_headless(title: String, width: Int, height: Int) -> window.Window {
    return window.open(title, width, height, headless=true)
}

// ───── colours ─────
define test_colours() -> void {
    test.assert_eq(window.rgb(255, 136, 0), window.hex("#ff8800"))
    test.assert_eq(window.hex("#f80"), window.hex("ff8800"))
    test.assert_eq(window.channels(window.rgba(1, 2, 3, 4)), [1, 2, 3, 4])
    test.assert_eq(window.channels(window.hex("#11223380")), [17, 34, 51, 128])
    test.assert_eq(window.channels(window.rgb(300, -5, 7)), [255, 0, 7, 255])
    caught := false
    try {
        window.hex("nope")
    } catch (ValueError) {
        caught = true
    }
    test.assert_true(caught)
}

define test_text_width() -> void {
    test.assert_eq(window.text_width("abc"), 24)
    test.assert_eq(window.text_width("abc", 2), 48)
    test.assert_eq(window.text_width("ab\nlonger"), 48)
    test.assert_eq(window.text_width("é"), 8)
}

// ───── drawing ─────
define test_open_and_size() -> void {
    if not window.available() { return }
    w := open_headless("size", 120, 80)
    test.assert_true(w.is_open())
    test.assert_eq(w.width(), 120)
    test.assert_eq(w.height(), 80)
    test.assert_eq(w.str(), "Window(\"size\", 120x80)")
    w.close()
    test.assert_false(w.is_open())
}

define test_shapes() -> void {
    if not window.available() { return }
    w := open_headless("shapes", 200, 100)
    w.clear(bg)
    w.rect(10, 10, 20, 20, window.rgb(255, 0, 0))
    w.rect(50, 10, 20, 20, window.rgb(0, 0, 255), fill=false)
    w.circle(100, 50, 10, window.rgb(0, 255, 0))
    w.line(0, 99, 199, 99, window.white())
    w.point(199, 0, window.rgb(1, 2, 3))
    test.assert_eq(w.pixel(0, 0), 0x0a141e)
    test.assert_eq(w.pixel(15, 15), 0xff0000)
    test.assert_eq(w.pixel(50, 15), 0x0000ff)
    test.assert_eq(w.pixel(60, 20), 0x0a141e)
    test.assert_eq(w.pixel(100, 50), 0x00ff00)
    test.assert_eq(w.pixel(100, 41), 0x00ff00)
    test.assert_eq(w.pixel(100, 38), 0x0a141e)
    test.assert_eq(w.pixel(120, 99), 0xffffff)
    test.assert_eq(w.pixel(199, 0), 0x010203)
    w.close()
}

define test_transparency_blends() -> void {
    if not window.available() { return }
    w := open_headless("alpha", 20, 20)
    w.clear(window.rgb(0, 0, 0))
    w.rect(0, 0, 20, 20, window.rgba(255, 255, 255, 128))
    c := window.channels(w.pixel(5, 5))
    test.assert_true(c[0] > 100 and c[0] < 160)
    w.close()
}

define test_text_draws_in_its_cell() -> void {
    if not window.available() { return }
    w := open_headless("text", 100, 40)
    w.clear(bg)
    test.assert_eq(w.text("Hi", 10, 10, window.rgb(0, 0, 255)), 16)
    inside := 0
    outside := 0
    for y in 0..40 {
        for x in 0..100 {
            if w.pixel(x, y) == 0x0000ff {
                if x >= 10 and x < 26 and y >= 10 and y < 26 { inside = inside + 1 } else { outside = outside + 1 }
            }
        }
    }
    test.assert_true(inside > 20)
    test.assert_eq(outside, 0)
    w.close()
}

define test_two_windows_are_separate() -> void {
    if not window.available() { return }
    a := open_headless("a", 30, 30)
    b := open_headless("b", 30, 30)
    a.clear(window.rgb(255, 0, 0))
    b.clear(window.rgb(0, 255, 0))
    test.assert_eq(a.pixel(5, 5), 0xff0000)
    test.assert_eq(b.pixel(5, 5), 0x00ff00)
    b.close()
    test.assert_true(a.is_open())
    a.close()
}

define test_screenshot_and_image() -> void {
    if not window.available() { return }
    dir := fs.temp_dir()
    w := open_headless("shot", 40, 30)
    w.clear(window.rgb(0, 128, 255))
    w.rect(0, 0, 10, 10, window.yellow())
    path := fs.join(dir, "shot.bmp")
    w.screenshot(path)
    test.assert_true(fs.size(path) > 40 * 30 * 3)
    img := w.load_image(path)
    // Saved at full resolution: 40 x 30 drawing pixels x the scale.
    test.assert_eq(img.width, Int(40 * w.scale() + 0.5))
    test.assert_eq(img.height, Int(30 * w.scale() + 0.5))
    w.clear(window.black())
    w.image(img, 0, 0, 40, 30)
    test.assert_eq(w.pixel(20, 20), 0x0080ff)
    test.assert_eq(w.pixel(5, 5), window.channels(window.yellow())[0] * 65536 + window.channels(window.yellow())[1] * 256 + window.channels(window.yellow())[2])
    w.image(img, 0, 0, 80, 60)
    img.free()
    w.close()
    fs.remove_tree(dir)
}

define test_load_missing_image_throws() -> void {
    if not window.available() { return }
    w := open_headless("img", 10, 10)
    caught := ""
    try {
        w.load_image("/nonexistent/x.bmp")
    } catch (e: window.WindowError) {
        caught = e.message
    }
    test.assert_contains(caught, "/nonexistent/x.bmp")
    w.close()
}

// ───── events / loop ─────
define test_events_and_wait() -> void {
    if not window.available() { return }
    w := open_headless("events", 10, 10)
    // Drain the startup events (focus...), which can arrive a little late.
    tries := 0
    while w.wait_event(50) != null and tries < 20 { tries = tries + 1 }
    t0 := window.ticks()
    e := w.wait_event(50)
    test.assert_true(e == null)
    test.assert_true(window.ticks() - t0 >= 40)
    w.close()
    test.assert_eq(w.events().length(), 0)
}

frames := 0

define _frame(w: window.Window, events: List) -> void {
    frames = frames + 1
    w.clear(window.blue())
    w.circle(5, 5, 3, window.white())
    if frames == 5 { w.close() }
}

define test_run_calls_frame_until_closed() -> void {
    if not window.available() { return }
    frames = 0
    w := open_headless("run", 20, 20)
    t0 := window.ticks()
    window.run(w, _frame, fps=100)
    test.assert_eq(frames, 5)
    test.assert_false(w.is_open())
    test.assert_true(window.ticks() - t0 >= 30)
}

define test_sleep() -> void {
    t0 := window.ticks()
    window.sleep(30)
    test.assert_true(window.ticks() - t0 >= 29)
}

// ───── image formats (tests/fixtures/images) ─────
images := "tests/fixtures/images/"

define test_png_with_transparency() -> void {
    if not window.available() { return }
    w := open_headless("png", 20, 20)
    img := w.load_image(images + "rgba.png")
    test.assert_eq(img.width, 4)
    test.assert_eq(img.height, 4)
    w.clear(window.rgb(10, 20, 30))
    w.image(img, 0, 0)
    test.assert_eq(w.pixel(0, 0), 0xff0000)
    test.assert_eq(w.pixel(1, 1), 0x00ff00)
    test.assert_eq(w.pixel(2, 2), 0x0000ff)
    test.assert_eq(w.pixel(0, 3), 0xffffff)
    test.assert_eq(w.pixel(3, 0), 0x0a141e)          // transparent column shows the background
    w.image(img, 10, 10, width=8, height=8)          // scaled 2x
    test.assert_eq(w.pixel(11, 13), 0x00ff00)
    w.close()
}

define test_jpeg_and_gif() -> void {
    if not window.available() { return }
    w := open_headless("jpg", 20, 20)
    jpg := w.load_image(images + "solid.jpg")
    test.assert_eq(jpg.width, 8)
    w.image(jpg, 0, 0)
    c := window.channels(w.pixel(4, 4))
    test.assert_true(c[0] > 190 and c[0] < 210 and c[1] > 90 and c[1] < 110 and c[2] > 40 and c[2] < 60)
    gif := w.load_image(images + "checker.gif")
    w.image(gif, 10, 10)
    test.assert_eq(w.pixel(10, 10), 0xff0000)
    test.assert_eq(w.pixel(11, 10), 0x0000ff)
    w.close()
}

define test_sprite_sheet_region_and_alpha() -> void {
    if not window.available() { return }
    w := open_headless("sheet", 40, 20)
    sheet := w.load_image(images + "sheet.png")
    test.assert_eq(sheet.width, 64)
    w.clear(window.black())
    w.image(sheet, 0, 0, src_x=32, src_w=16, src_h=16)   // third frame: blue
    test.assert_eq(w.pixel(8, 8), 0x0000ff)
    test.assert_eq(w.pixel(20, 8), 0x000000)              // only 16px drawn
    w.image(sheet, 20, 0, src_x=48)                        // last frame to the edge
    test.assert_eq(w.pixel(30, 8), 0xffff00)
    w.clear(window.black())
    w.image(sheet, 0, 0, src_w=16, alpha=128)              // half-transparent red
    c := window.channels(w.pixel(4, 4))
    test.assert_true(c[0] > 110 and c[0] < 140)
    w.close()
}

define test_bad_image_file_throws() -> void {
    if not window.available() { return }
    w := open_headless("bad", 10, 10)
    caught := ""
    try {
        w.load_image(images + "not_an_image.png")
    } catch (e: window.WindowError) {
        caught = e.message
    }
    test.assert_contains(caught, "not an image")
    w.close()
}

// ───── clipping and the clipboard (v1.2.0) ─────
define test_clip_limits_drawing() -> void {
    if not window.available() { return }
    w := open_headless("clip", 100, 80)
    w.clear(bg)
    w.clip(10, 10, 20, 20)
    w.rect(0, 0, 100, 80, window.white())
    test.assert_eq(w.pixel(15, 15), 0xffffff)
    test.assert_eq(w.pixel(9, 15), w.pixel(50, 50))       // still the background
    test.assert_eq(w.pixel(30, 30), w.pixel(50, 50))      // right / bottom edge excluded
    w.unclip()
    w.rect(60, 60, 5, 5, window.white())
    test.assert_eq(w.pixel(62, 62), 0xffffff)
    w.clip(0, 0, -5, 10)                                  // negative size: nothing drawn
    w.rect(0, 0, 100, 80, window.red())
    test.assert_eq(w.pixel(62, 62), 0xffffff)
    w.close()
}

define test_clipboard_round_trip() -> void {
    window.set_clipboard("copied ✓")
    test.assert_eq(window.clipboard(), "copied ✓")
    window.set_clipboard("")
    test.assert_eq(window.clipboard(), "")
}

// ───── TrueType fonts (v1.3.0) ─────
// A font that's usually installed; the font tests skip when none is.
define system_font() -> String {
    for p in ["/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
              "/usr/share/fonts/TTF/DejaVuSans.ttf",
              "/usr/share/fonts/dejavu/DejaVuSans.ttf",
              "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
              "/System/Library/Fonts/Supplemental/Arial.ttf",
              "/Library/Fonts/Arial.ttf",
              "C:\\Windows\\Fonts\\arial.ttf"] {
        path: String = p
        if fs.exists(path) { return path }
    }
    return ""
}

define test_font_metrics_and_width() -> void {
    path := system_font()
    if path == "" { return }
    f := window.load_font(path, 20)
    test.assert_eq(f.size, 20)
    test.assert_true(f.ascent > 10 and f.ascent <= 20)
    test.assert_true(f.descent > 0)
    test.assert_true(f.line_height >= f.ascent + f.descent)
    test.assert_eq(f.width(""), 0)
    test.assert_true(f.width("WWW") > f.width("iii"))          // proportional
    test.assert_eq(f.width("ab\nab"), f.width("ab"))            // longest line
    test.assert_true(f.width("✓") > 0 or f.width("é") > 0)      // UTF-8 decoded
    f.free()
    test.assert_eq(f.width("x"), 0)                              // freed: nothing
}

define test_font_drawing() -> void {
    path := system_font()
    if path == "" or not window.available() { return }
    w := open_headless("font", 120, 40)
    f := window.load_font(path, 24)
    w.clear(window.black())
    n := w.text("H", 10, 5, window.white(), font=f)
    test.assert_eq(n, f.width("H"))
    // Some pixel of the H's stem is lit.
    lit := false
    y := 5
    while y < 5 + f.ascent {
        x := 10
        while x < 10 + n {
            if w.pixel(x, y) != 0 { lit = true }
            x = x + 1
        }
        y = y + 1
    }
    test.assert_true(lit)
    test.assert_eq(w.pixel(100, 30), 0)                          // nothing elsewhere
    w.close()
}

define test_font_load_errors() -> void {
    caught := ""
    try {
        window.load_font("/no/such/font.ttf", 12)
    } catch (e: window.WindowError) {
        caught = e.message
    }
    test.assert_contains(caught, "can't open")
    caught = ""
    try {
        window.load_font(images + "rgba.png", 12)
    } catch (e: window.WindowError) {
        caught = e.message
    }
    test.assert_contains(caught, "isn't a TrueType")
}

// High DPI: drawing is in logical pixels whatever the scale (QUIRK_UI_SCALE
// / the screen's pixel ratio) — the size is what was asked for, and a
// rectangle covers the same logical pixels.
define test_scale_keeps_logical_pixels() -> void {
    if not window.available() { return }
    w := open_headless("scale", 80, 60)
    test.assert_true(w.scale() >= 0.5)
    test.assert_eq(w.width(), 80)
    test.assert_eq(w.height(), 60)
    w.clear(window.black())
    w.rect(10, 10, 20, 20, window.white(), fill=true)
    test.assert_eq(w.pixel(10, 10), 0xFFFFFF)
    test.assert_eq(w.pixel(29, 29), 0xFFFFFF)
    test.assert_eq(w.pixel(30, 30), 0)
    test.assert_eq(w.pixel(9, 9), 0)
    w.close()
}

// IME: a composition arrives as "compose" events (text, cursor, selected
// length), then the result as "text".
define test_ime_compose_then_text() -> void {
    if not window.available() { return }
    w := open_headless("ime", 40, 20)
    w.text_input_area(5, 5, 1, 16)
    w.simulate_text("にほ", compose=true, cursor=2)
    w.simulate_text("日本", compose=true, cursor=2, length=2)
    w.simulate_text("日本", compose=false)
    w.simulate_text("", compose=true)
    got := []
    for e in w.events() {
        ev: window.Event = e
        got.append(ev.kind + ":" + ev.text + ":" + String(ev.cursor) + ":" + String(ev.length))
    }
    test.assert_eq(got, ["compose:にほ:2:0", "compose:日本:2:2", "text:日本:0:0", "compose::0:0"])
    w.close()
}

// Font fallback: characters the font lacks come from a fallback font —
// an added one, or the system's (when it has one for the script).
define test_font_fallback() -> void {
    path := system_font()
    if path == "" { return }
    plain := window.load_font(path, 20, fallback=false)
    test.assert_true(plain.covers("Hello"))
    test.assert_false(plain.covers("日本"))
    cjk := ""
    for p in ["/usr/share/fonts/opentype/ipafont-gothic/ipag.ttf",
              "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
              "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
              "/System/Library/Fonts/PingFang.ttc",
              "C:\\Windows\\Fonts\\msyh.ttc"] {
        q: String = p
        if fs.exists(q) { cjk = q }
    }
    if cjk == "" { return }
    before := plain.width("日本")
    plain.add_fallback(cjk)
    test.assert_true(plain.covers("Hello 日本"))
    test.assert_true(plain.width("日本") != before)          // now measured from the fallback
    test.assert_eq(plain.line_height, window.load_font(path, 20, fallback=false).line_height)
    auto := window.load_font(path, 20)
    test.assert_true(auto.covers("日本"))                     // a system font has it
    if window.available() {
        w := open_headless("fallback", 80, 40)
        w.clear(window.black())
        n := w.text("日", 4, 4, window.white(), font=plain)
        lit := false
        y := 4
        while y < 30 {
            x := 4
            while x < 4 + n {
                if w.pixel(x, y) != 0 { lit = true }
                x = x + 1
            }
            y = y + 1
        }
        test.assert_true(lit)
        w.close()
    }
    caught := false
    try {
        plain.add_fallback("/nonexistent/font.ttf")
    } catch (window.WindowError) {
        caught = true
    }
    test.assert_true(caught)
}

// Right-to-left text: Hebrew is drawn in visual order (the first letter
// on the right), carets and clicks follow it, mixed runs keep their own
// direction; Arabic letters take their joined forms.
define test_rtl_layout_and_carets() -> void {
    path := system_font()
    if path == "" { return }
    f := window.load_font(path, 20)
    if not f.covers("שלום") { return }
    test.assert_true(window.is_rtl("שלום abc"))
    test.assert_false(window.is_rtl("abc שלום"))
    test.assert_false(window.is_rtl("123"))
    he := "שלום"
    w := f.width(he)
    test.assert_true(w - f.caret_x(he, 0) <= 1)            // before the first letter: the right edge (width rounds up)
    test.assert_eq(f.caret_x(he, 4), 0)                   // after the last: the left edge
    test.assert_true(f.caret_x(he, 1) < w and f.caret_x(he, 1) > 0)
    test.assert_eq(f.index_at(he, w - 1), 0)               // clicking near the right edge
    test.assert_eq(f.index_at(he, 0), 4)
    // Plain text: carets are prefix widths.
    test.assert_true(f.width("ab") - f.caret_x("abc", 2) <= 1)
    test.assert_eq(f.index_at("abc", f.caret_x("abc", 2)), 2)
    // Mixed: "ab " then a Hebrew run; selecting across both gives two pieces.
    mixed := "ab שלום"
    test.assert_eq(f.caret_x(mixed, 0), 0)
    test.assert_true(f.caret_x(mixed, 3) > f.caret_x(mixed, 4))   // inside the RTL run carets go leftwards
    test.assert_eq(f.selection(mixed, 0, 2).length(), 1)
    test.assert_eq(f.selection(mixed, 1, 5).length(), 2)
    // Arabic joins: the word is narrower than its letters drawn apart.
    if f.covers("سلام") {
        test.assert_true(f.width("سلام") < f.width("س") + f.width("ل") + f.width("ا") + f.width("م"))
    }
}

// Accessibility bridge: the calls are safe everywhere (a no-op where no
// screen reader is attached — headless, Linux and macOS for now).
define test_access_bridge_calls() -> void {
    if not window.available() { return }
    w := open_headless("a11y", 40, 20)
    test.assert_false(w.access_active())
    w.access_update([1, 2], [-1, 0], ["window", "button"], ["a11y", "OK"], ["", ""], ["", ""],
                    [0, 3], [0, 0, 40, 20, 2, 2, 20, 10], [0, 0, 0, 0, 0, 0, 0, 0])
    w.access_focus(2)
    w.access_changed(2, "name")
    w.access_announce("hello")
    e := window.Event("access")
    test.assert_eq(e.action, "")
    test.assert_eq(e.target, 0)
    w.close()
}
